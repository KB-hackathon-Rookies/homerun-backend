# AI 코치 로컬 실행용. compose 로 띄울 때는 루트 .env 의 값이 주입된다.

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Spring 백엔드의 JWT_SECRET 과 반드시 동일해야 토큰 검증이 통과한다.
JWT_SECRET=
JWT_ALGORITHM=HS256

# ChromaDB (임베디드 persistent)
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=homerun_corpus

# 검색 상위 k
TOP_K=4

# CORS 허용 오리진(쉼표 구분). 프론트 오리진을 넣는다. 개발 중엔 * 허용 가능.
CORS_ORIGINS=*
