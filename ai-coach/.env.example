# AI 코치 로컬 실행용. compose 로 띄울 때는 루트 .env 의 값이 주입된다.

# OpenAI (임베딩은 항상 이 키/기본 엔드포인트를 쓴다 — 코퍼스가 이 임베딩으로 인제스트돼 있다)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=10
OPENAI_MAX_RETRIES=1

# 챗 LLM 모델. Qwen 으로 바꾸려면 여기에 Qwen 모델명을 넣는다(예: qwen-plus).
OPENAI_CHAT_MODEL=gpt-4o-mini

# 챗만 OpenAI 호환 다른 provider 로 교체할 때 채운다(임베딩은 그대로 OpenAI).
# 비우면 위 OPENAI_API_KEY + OpenAI 기본 엔드포인트로 폴백한다(= 기존 GPT 동작).
#
# Qwen(알리바바 DashScope, OpenAI 호환):
#   CHAT_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1  # 중국 리전은 dashscope.aliyuncs.com
#   CHAT_API_KEY=<DashScope API 키(sk-...)>
#   OPENAI_CHAT_MODEL=qwen-plus   # qwen-turbo / qwen-max 등
# 자체 호스팅(vLLM 등)이면 CHAT_BASE_URL 을 그 OpenAI 호환 엔드포인트로 둔다.
CHAT_BASE_URL=
CHAT_API_KEY=

# Spring 백엔드의 JWT_SECRET 과 반드시 동일해야 토큰 검증이 통과한다.
JWT_SECRET=
JWT_ALGORITHM=HS256

# ChromaDB (임베디드 persistent)
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=homerun_corpus

# 검색 상위 k
TOP_K=4
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_MAX_DISTANCE=0.75

# Redis 단기 대화 기억. context 원문은 저장하지 않으며 TTL 뒤 자동 삭제된다.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
CONVERSATION_TTL_SECONDS=1800
CONVERSATION_MAX_TURNS=5

# CORS 허용 오리진(쉼표 구분). 프론트 오리진을 넣는다. 개발 중엔 * 허용 가능.
CORS_ORIGINS=*
