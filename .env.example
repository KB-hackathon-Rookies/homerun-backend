# .env 로 복사해서 쓴다. compose.yaml / compose.prod.yaml 이 읽는 값들.
#   cp .env.example .env
# 외부 조회 API 공통 장애 대응 설정
EXTERNAL_API_CONNECT_TIMEOUT=3s
EXTERNAL_API_READ_TIMEOUT=5s
EXTERNAL_API_MAX_ATTEMPTS=2
EXTERNAL_API_RETRY_BACKOFF=200ms

POSTGRES_DB=homerun
POSTGRES_USER=homerun
# 비워 두면 compose 가 즉시 에러를 낸다. 로컬은 아무 값이나 넣으면 된다.
POSTGRES_PASSWORD=change-me
# 로컬에 이미 PostgreSQL(5432)이 떠 있으면 5433 같은 다른 포트로 바꾼다.
POSTGRES_PORT=5432

# 회원가입 이메일 인증번호와 단기 인증 상태를 저장한다.
REDIS_PORT=6379
# 로컬은 임의 값, 운영은 긴 무작위 문자열을 사용한다.
REDIS_PASSWORD=change-me

# 외부 API 키. 실제 값은 .env에만 넣고 저장소에는 커밋하지 않는다.
# 도로명주소 검색 API에서 발급받은 승인키
JUSO_CONFIRM_KEY=
# 공공데이터포털(data.go.kr)의 Decoding(일반) 인증키
DATA_GO_KR_SERVICE_KEY=

# 금융결제원 오픈뱅킹 테스트베드. 운영 전환 시 BASE_URL 두 값을 운영 주소로 바꾼다.
OPEN_BANKING_OAUTH_BASE_URL=https://testapi.openbanking.or.kr
OPEN_BANKING_API_BASE_URL=https://testapi.openbanking.or.kr
OPEN_BANKING_CLIENT_ID=
OPEN_BANKING_CLIENT_SECRET=
OPEN_BANKING_CLIENT_USE_CODE=
OPEN_BANKING_REDIRECT_URI=http://localhost:8080/api/v1/open-banking/callback
# 대출·리스 API는 금융결제원에서 승인된 경우에만 insuinfo/sa scope를 추가하세요.
OPEN_BANKING_SCOPE=login inquiry
# openssl rand -base64 32 로 생성한 32바이트 Base64 키
OPEN_BANKING_TOKEN_ENCRYPTION_KEY=

# 소셜 로그인. 실제 키는 절대 커밋하지 않는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/v1/auth/kakao/callback

# 32자 이상의 무작위 문자열. 예: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=1800
REFRESH_TOKEN_EXPIRATION_DAYS=14
# HTTPS 배포 환경에서는 true로 바꾼다.
AUTH_COOKIE_SECURE=false

# 프론트 주소. 쿠키를 싣는 요청이라 와일드카드를 쓸 수 없어 명시해야 한다.
# 여러 개면 콤마로 잇는다. 배포 주소가 생기면 여기에 덧붙인다.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Gmail SMTP. MAIL_PASSWORD에는 Google 계정 비밀번호가 아닌 앱 비밀번호를 넣는다.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# 인증번호 해시에 쓰는 32자 이상의 별도 무작위 문자열.
EMAIL_VERIFICATION_SECRET=
# 휴대전화 인증번호 해시에 쓰는 32자 이상의 별도 무작위 문자열.
# 비워 두면 EMAIL_VERIFICATION_SECRET 값을 사용한다.
PHONE_VERIFICATION_SECRET=

# Solapi(CoolSMS) 휴대전화 인증 문자 발송. 세 값이 모두 있으면 실발송, 비어 있으면 SMS 스텁을 쓴다.
# SENDER에는 Solapi 콘솔에서 사전등록·승인된 발신번호를 숫자만 넣는다.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=

# compose.prod.yaml 에서만 쓴다.
APP_PORT=8080
# CD 가 올린 이미지로 배포/롤백할 때 지정한다. 비우면 로컬 빌드 이미지를 쓴다.
# IMAGE=ghcr.io/kb-hackathon-rookies/homerun-backend:abc123def456

# 알림(FCM). 기본은 꺼둔다(NoOpFcmSender 로 부팅). 실제 전송하려면 true + 서비스계정 JSON.
FCM_ENABLED=false
# 서비스계정 JSON 원본 / base64 인코딩 JSON / 파일 경로 중 하나.
FIREBASE_CREDENTIALS=
# 마감 스캔 cron(KST). 기본 매일 09:00.
NOTIFICATION_DEADLINE_CRON=0 0 9 * * *
NOTIFICATION_RECOVERY_MIN_AGE=5m
NOTIFICATION_RECOVERY_BATCH_SIZE=100
NOTIFICATION_RECOVERY_FIXED_DELAY=60s

# AI 코치(FastAPI + ChromaDB). Spring 과 같은 JWT_SECRET 을 공유한다.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_COACH_PORT=8000
CHROMA_DIR=/data/chroma
